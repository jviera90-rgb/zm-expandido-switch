new file mode 100644
index 0000000..9140df8
--- /dev/null
+++ b/src/platform/switch/copy_if_exists.cmake
@@ -0,0 +1,8 @@
+# Copia a ROM para dentro do .nro só se o jogador a colocou em res/zm/game.gba
+# (compatível com CMake antigo: file(COPY) mantém o nome game.gba)
+if(EXISTS "${SRC}")
+	file(COPY "${SRC}" DESTINATION "${DST_DIR}")
+	message(STATUS "ROM embutida no .nro: ${SRC}")
+else()
+	message(STATUS "Sem ROM embutida: o app vai procurar em /switch/zm-expandido/")
+endif()
