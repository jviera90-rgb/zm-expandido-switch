+/* ---- Zero Mission Expandido: app próprio que abre direto no jogo ---- */
+#define ZM_APP_DIR "sdmc:/switch/zm-expandido"
+#define ZM_ROM_NAME "zm-expandido.gba"
+
+/* Procura a ROM do hack: primeiro embutida no próprio .nro (romfs),
+ * depois na pasta do app no cartão SD. */
+static const char* _zmFindRom(void) {
+	static const char* const candidates[] = {
+		"romfs:/game.gba",
+		ZM_APP_DIR "/" ZM_ROM_NAME,
+	};
+	size_t i;
+	for (i = 0; i < sizeof(candidates) / sizeof(*candidates); ++i) {
+		struct stat st;
+		if (stat(candidates[i], &st) == 0 && S_ISREG(st.st_mode)) {
+			return candidates[i];
+		}
+	}
+	return NULL;
+}
